generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator fabbrica {
  provider = "prisma-fabbrica"
  output   = "../src/generated/fabbrica"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id          String @id @default(uuid()) @db.Uuid
  clerkUserId String @unique @map("clerk_user_id")

  challengeSubmissions ChallengeSubmission[]
  lessonItems          LessonItem[]
  onboardingQuestions  OnboardingQuestion[]
  quizAttempts         QuizAttempt[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("accounts")
}

model Course {
  id                          String                       @id @default(uuid()) @db.Uuid
  slug                        String                       @unique
  title                       String
  description                 String
  outcomes                    String
  lessons                     Lesson[]
  onboardingQuestionTemplates OnboardingQuestionTemplate[]
  onboardingQuestions         OnboardingQuestion[]
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  @@map("courses")
}

model OnboardingQuestionTemplate {
  id                  String               @id @default(uuid()) @db.Uuid
  courseId            String               @map("course_id") @db.Uuid
  position            Int
  question            String
  description         String
  course              Course               @relation(fields: [courseId], references: [id])
  onboardingQuestions OnboardingQuestion[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([courseId, position])
  @@map("onboarding_question_templates")
}

model OnboardingQuestion {
  id          String                      @id @default(uuid()) @db.Uuid
  courseId    String                      @map("course_id") @db.Uuid
  learnerId   String                      @map("learner_id") @db.Uuid
  templateId  String?                     @map("template_id") @db.Uuid
  position    Int
  question    String
  answer      String?
  description String
  origin      OnboardingQuestionOrigin
  course      Course                      @relation(fields: [courseId], references: [id])
  learner     Account                     @relation(fields: [learnerId], references: [id])
  template    OnboardingQuestionTemplate? @relation(fields: [templateId], references: [id])
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  @@unique([courseId, learnerId, position])
  @@unique([templateId, learnerId])
  @@index([learnerId])
  @@map("onboarding_questions")
}

model Lesson {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid

  slug        String
  title       String
  description String
  outcomes    String
  position    Int

  quiz          Boolean? @map("quiz")
  codeChallenge Boolean? @map("code_challenge")

  lessonItems    LessonItem[]
  lessonArticles LessonArticle[]
  quizAttempts   QuizAttempt[]
  course         Course          @relation(fields: [courseId], references: [id])

  /// prisma-lint-ignore-field require-default-empty-arrays
  quizzes Quiz[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@map("lessons")
}

model LessonArticle {
  id       String  @id @default(uuid()) @db.Uuid
  lessonId String  @map("lesson_id") @db.Uuid
  content  Json
  title    String?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId])
  @@map("lesson_articles")
}

model LessonItem {
  id          String    @id @default(uuid()) @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  learnerId   String    @map("learner_id") @db.Uuid
  title       String
  completedAt DateTime? @map("completed_at")
  position    Int
  learner     Account   @relation(fields: [learnerId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([lessonId, learnerId, position])
  @@unique([lessonId, learnerId, title])
  @@index([learnerId])
  @@map("lesson_items")
}

model Challenge {
  id          String                @id @default(uuid()) @db.Uuid
  prompt      String
  starterCode String?               @map("starter_code")
  solution    String?
  difficulty  String
  language    String                @default("python")
  submissions ChallengeSubmission[]
  testCases   ChallengeTestCase[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("challenges")
}

model ChallengeTestCase {
  id             String    @id @default(uuid()) @db.Uuid
  challengeId    String    @map("challenge_id") @db.Uuid
  input          String
  expectedOutput String    @map("expected_output")
  isHidden       Boolean   @default(false) @map("is_hidden")
  position       Int
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([challengeId, position])
  @@index([challengeId])
  @@map("challenge_test_cases")
}

model ChallengeSubmission {
  id          String    @id @default(uuid()) @db.Uuid
  challengeId String    @map("challenge_id") @db.Uuid
  userCode    String    @map("user_code")
  feedback    String
  correct     Boolean
  accountId   String?   @map("account_id") @db.Uuid
  account     Account?  @relation(fields: [accountId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([challengeId])
  @@index([accountId])
  @@map("challenge_submissions")
}

model Quiz {
  id        String         @id @default(uuid()) @db.Uuid
  lessonId  String         @map("lesson_id") @db.Uuid
  title     String
  attempts  QuizAttempt[]
  questions QuizQuestion[]
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id             String              @id @default(uuid()) @db.Uuid
  quizId         String              @map("quiz_id") @db.Uuid
  prompt         String
  position       Int
  attemptAnswers QuizAttemptAnswer[]
  options        QuizOption[]
  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([quizId, position])
  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id                 String              @id @default(uuid()) @db.Uuid
  questionId         String              @map("question_id") @db.Uuid
  text               String
  position           Int
  selectedInAttempts QuizAttemptAnswer[]
  question           QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([questionId, position])
  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id              String              @id @default(uuid()) @db.Uuid
  learnerId       String              @map("learner_id") @db.Uuid
  lessonId        String              @map("lesson_id") @db.Uuid
  score           Int
  totalQuestions  Int                 @map("total_questions")
  passed          Boolean
  overallFeedback String              @map("overall_feedback")
  quizId          String              @map("quiz_id") @db.Uuid
  answers         QuizAttemptAnswer[]
  learner         Account             @relation(fields: [learnerId], references: [id])
  lesson          Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz            Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([learnerId])
  @@index([lessonId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String       @id @default(uuid()) @db.Uuid
  attemptId        String       @map("attempt_id") @db.Uuid
  questionId       String       @map("question_id") @db.Uuid
  selectedOptionId String       @map("selected_option_id") @db.Uuid
  isCorrect        Boolean      @map("is_correct")
  feedback         String?
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
  @@map("quiz_attempt_answers")
}

enum OnboardingQuestionOrigin {
  GENERATED
  TEMPLATE
}
