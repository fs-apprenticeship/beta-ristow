generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator fabbrica {
  provider = "prisma-fabbrica"
  output   = "../src/generated/fabbrica"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingQuestionOrigin {
  GENERATED
  TEMPLATE
}

model Account {
  id                  String               @id @default(uuid()) @db.Uuid
  clerkUserId         String               @unique @map("clerk_user_id")
  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestions OnboardingQuestion[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("accounts")
}

model Course {
  id                          String                       @id @default(uuid()) @db.Uuid
  slug                        String
  title                       String
  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestions         OnboardingQuestion[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestionTemplates OnboardingQuestionTemplate[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  lessons                     Lesson[]
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  @@unique([slug])
  @@map("courses")
}

model OnboardingQuestionTemplate {
  id                  String               @id @default(uuid()) @db.Uuid
  courseId            String               @map("course_id") @db.Uuid
  position            Int
  question            String               @db.Text
  description         String               @db.Text
  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestions OnboardingQuestion[]
  course              Course               @relation(fields: [courseId], references: [id])
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([courseId, position])
  @@map("onboarding_question_templates")
}

model OnboardingQuestion {
  id          String                      @id @default(uuid()) @db.Uuid
  courseId    String                      @map("course_id") @db.Uuid
  learnerId   String                      @map("learner_id") @db.Uuid
  templateId  String?                     @map("template_id") @db.Uuid
  position    Int
  question    String                      @db.Text
  answer      String?                     @db.Text
  description String                      @db.Text
  origin      OnboardingQuestionOrigin
  course      Course                      @relation(fields: [courseId], references: [id])
  learner     Account                     @relation(fields: [learnerId], references: [id])
  template    OnboardingQuestionTemplate? @relation(fields: [templateId], references: [id])
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  @@unique([courseId, learnerId, position])
  @@unique([templateId, learnerId])
  @@index([learnerId])
  @@map("onboarding_questions")
}

model Lesson {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  slug      String
  title     String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, slug])
  @@map("lessons")
}
