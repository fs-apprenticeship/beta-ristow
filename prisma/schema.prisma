generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator fabbrica {
  provider = "prisma-fabbrica"
  output   = "../src/generated/fabbrica"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingQuestionOrigin {
  GENERATED
  TEMPLATE
}

model Account {
  id          String @id @default(uuid()) @db.Uuid
  clerkUserId String @unique @map("clerk_user_id")

  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestions OnboardingQuestion[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  lessonItems         LessonItem[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  quizAttempts        QuizAttempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("accounts")
}

model Course {
  id                          String                       @id @default(uuid()) @db.Uuid
  slug                        String
  title                       String
  description                 String
  outcomes                    String
  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestions         OnboardingQuestion[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestionTemplates OnboardingQuestionTemplate[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  lessons                     Lesson[]
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  @@unique([slug])
  @@map("courses")
}

model OnboardingQuestionTemplate {
  id                  String               @id @default(uuid()) @db.Uuid
  courseId            String               @map("course_id") @db.Uuid
  position            Int
  question            String               @db.Text
  description         String               @db.Text
  /// prisma-lint-ignore-field require-default-empty-arrays
  onboardingQuestions OnboardingQuestion[]
  course              Course               @relation(fields: [courseId], references: [id])
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([courseId, position])
  @@map("onboarding_question_templates")
}

model OnboardingQuestion {
  id          String                      @id @default(uuid()) @db.Uuid
  courseId    String                      @map("course_id") @db.Uuid
  learnerId   String                      @map("learner_id") @db.Uuid
  templateId  String?                     @map("template_id") @db.Uuid
  position    Int
  question    String                      @db.Text
  answer      String?                     @db.Text
  description String                      @db.Text
  origin      OnboardingQuestionOrigin
  course      Course                      @relation(fields: [courseId], references: [id])
  learner     Account                     @relation(fields: [learnerId], references: [id])
  template    OnboardingQuestionTemplate? @relation(fields: [templateId], references: [id])
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  @@unique([courseId, learnerId, position])
  @@unique([templateId, learnerId])
  @@index([learnerId])
  @@map("onboarding_questions")
}

model Lesson {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid

  slug        String
  title       String
  description String
  outcomes    String
  position    Int

  /// prisma-lint-ignore-field require-default-empty-arrays
  lessonItems   LessonItem[]
  lessonArticle LessonArticle?
  /// prisma-lint-ignore-field require-default-empty-arrays
  quizAttempts  QuizAttempt[]
  course        Course         @relation(fields: [courseId], references: [id])

  /// prisma-lint-ignore-field require-default-empty-arrays
  quizzes Quiz[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@map("lessons")
}

model LessonArticle {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @unique @map("lesson_id") @db.Uuid
  content  Json

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lesson_articles")
}

model LessonItem {
  id        String @id @default(uuid()) @db.Uuid
  lessonId  String @map("lesson_id") @db.Uuid
  learnerId String @map("learner_id") @db.Uuid

  title       String
  completedAt DateTime? @map("completed_at")
  position    Int

  lesson  Lesson  @relation(fields: [lessonId], references: [id])
  learner Account @relation(fields: [learnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lessonId, learnerId, position])
  @@unique([lessonId, learnerId, title])
  @@index([learnerId])
  @@map("lesson_items")
}

model Challenge {
  id String @id @default(uuid()) @db.Uuid

  prompt      String  @db.Text
  starterCode String? @map("starter_code") @db.Text
  solution    String? @db.Text
  difficulty  String
  language    String  @default("python")

  /// prisma-lint-ignore-field require-default-empty-arrays
  submissions ChallengeSubmission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("challenges")
}

model ChallengeSubmission {
  id          String  @id @default(uuid()) @db.Uuid
  challengeId String  @map("challenge_id") @db.Uuid
  userCode    String  @map("user_code") @db.Text
  feedback    String  @db.Text
  correct     Boolean

  challenge Challenge @relation(fields: [challengeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([challengeId])
  @@map("challenge_submissions")
}

model Quiz {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid

  title  String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// prisma-lint-ignore-field require-default-empty-arrays
  questions QuizQuestion[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  attempts  QuizAttempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id     String @id @default(uuid()) @db.Uuid
  quizId String @map("quiz_id") @db.Uuid

  prompt   String @db.Text
  position Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  /// prisma-lint-ignore-field require-default-empty-arrays
  options        QuizOption[]
  /// prisma-lint-ignore-field require-default-empty-arrays
  attemptAnswers QuizAttemptAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([quizId, position])
  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid

  text     String @db.Text
  position Int

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// prisma-lint-ignore-field require-default-empty-arrays
  selectedInAttempts QuizAttemptAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([questionId, position])
  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id        String @id @default(uuid()) @db.Uuid
  learnerId String @map("learner_id") @db.Uuid
  lessonId  String @map("lesson_id") @db.Uuid
  quizId    String @map("quiz_id") @db.Uuid

  score           Int
  totalQuestions  Int     @map("total_questions")
  passed          Boolean
  overallFeedback String  @map("overall_feedback") @db.Text

  learner Account @relation(fields: [learnerId], references: [id])
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  /// prisma-lint-ignore-field require-default-empty-arrays
  answers QuizAttemptAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([learnerId])
  @@index([lessonId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String  @id @default(uuid()) @db.Uuid
  attemptId        String  @map("attempt_id") @db.Uuid
  questionId       String  @map("question_id") @db.Uuid
  selectedOptionId String  @map("selected_option_id") @db.Uuid
  isCorrect        Boolean @map("is_correct")
  feedback         String? @db.Text

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuizOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
  @@map("quiz_attempt_answers")
}
